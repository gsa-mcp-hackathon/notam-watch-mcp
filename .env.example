# Copy to .env for running outside Databricks. Values here override process
# environment variables for every setting; empty values are ignored. When the
# NMS/SWIM credentials below are all filled in, the Databricks secret scope is
# never contacted. Use NFS_ENV_FILE=/path/to/file to load a different file.
# NFS_SECRET_SCOPE=none disables the secret-scope fallback entirely.
# The MCP server reads only MCP_* and LAKEBASE_*; the NMS/SWIM/Databricks
# settings are for the ingestion jobs (ingestion/nfs_ingest/config.py).
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# FAA NMS API (use secrets; never commit real values)
NMS_AUTH_URL=
NMS_API_BASE_URL=
NMS_CLIENT_ID=
NMS_CLIENT_SECRET=
NMS_TIMEOUT_SECONDS=30
NMS_PROBE_WINDOW_MINUTES=1
NMS_INCREMENTAL_MAX_LOOKBACK_HOURS=24
NMS_INCREMENTAL_OVERLAP_MINUTES=2
NMS_WATERMARK_TABLE=users.nfs_demo.nfs_ingestion_watermarks
NMS_BRONZE_TABLE=users.nfs_demo.nfs_nms_notam_events_raw
NOTAM_VERSIONS_TABLE=users.nfs_demo.nfs_notam_versions
NOTAM_HAZARDS_TABLE=users.nfs_demo.nfs_notam_hazard_volumes

# FAA SWIM R14 / Solace subscription
SWIM_HOST=
SWIM_VPN=TFMS
SWIM_QUEUE=
SWIM_USERNAME=
SWIM_PASSWORD=
SWIM_CERT_PATH=
SWIM_TLS_VALIDATE=true
SWIM_CONNECT_RETRIES=1
SWIM_RETRY_INTERVAL_MS=1000
SWIM_RECEIVE_TIMEOUT_MS=120000
SWIM_BRONZE_TABLE=users.nfs_demo.nfs_swim_flight_events_raw

# Local Databricks SQL test settings. Hosted apps use injected credentials.
DATABRICKS_PROFILE=
DATABRICKS_WAREHOUSE_ID=

# Lakebase Postgres/PostGIS serving database. Authentication uses short-lived
# Databricks OAuth database credentials; do not store a PostgreSQL password.
LAKEBASE_PROJECT_ID=nfs-aviation-postgis
LAKEBASE_BRANCH_ID=production
LAKEBASE_ENDPOINT_ID=primary
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_HOST=
